pipeline {
    agent any

    parameters {
        choice(
            name: 'APP',
            choices: [
                'first-app',
                'second-app'
            ],
            description: 'Choose which chat application to build and push'
        )
    }

    environment {
        PATH = "/Users/user/.docker/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"

        NEXUS_PYPI_URL = 'http://localhost:8081/repository/pypi-group/simple/'
    }

    stages {

        stage('Configure Application') {
            steps {
                script {
                    if (params.APP == 'first-app') {
                        env.APP_DIR = 'app/first_app'
                        env.IMAGE_NAME = 'first-app-image'
                    }
                    else if (params.APP == 'second-app') {
                        env.APP_DIR = 'app/second_app'
                        env.IMAGE_NAME = 'second-app-image'
                    }
                    else {
                        error("Unknown application: ${params.APP}")
                    }

                    echo "======================================"
                    echo "Selected application: ${params.APP}"
                    echo "Application directory: ${env.APP_DIR}"
                    echo "Docker image: ${env.IMAGE_NAME}"
                    echo "======================================"
                }
            }
        }

        stage('Environment') {
            steps {
                sh '''
                    echo "===== ENVIRONMENT ====="

                    python3 --version
                    docker --version
                    git --version

                    echo "===== WORKSPACE ====="
                    pwd
                    ls -la

                    echo "===== APPLICATION ====="
                    echo "APP=${APP}"
                    echo "APP_DIR=${APP_DIR}"
                    echo "IMAGE_NAME=${IMAGE_NAME}"

                    echo "===== BUILD ====="
                    echo "BUILD_NUMBER=${BUILD_NUMBER}"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.APP_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-key',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "===== CREATE VIRTUAL ENVIRONMENT ====="

                            rm -rf .venv
                            python3 -m venv .venv

                            .venv/bin/python -m pip install --upgrade pip

                            echo "===== INSTALL REQUIREMENTS FROM NEXUS ====="

                            .venv/bin/pip install \
                                --index-url "http://${NEXUS_USER}:${NEXUS_PASSWORD}@localhost:8081/repository/pypi-group/simple/" \
                                -r requirements.txt

                            echo "===== INSTALLED PACKAGES ====="

                            .venv/bin/pip list
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${env.APP_DIR}") {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-key',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            set -e

                            echo "===== DOCKER BUILD ====="
                            echo "Building ${IMAGE_NAME}"

                            docker build \
                                --build-arg NEXUS_URL="http://${NEXUS_USER}:${NEXUS_PASSWORD}@host.docker.internal:8081/repository/pypi-group/simple/" \
                                -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                                -t ${IMAGE_NAME}:latest \
                                .
                        '''
                    }
                }
            }
        }

        stage('Docker Images') {
            steps {
                sh '''
                    echo "===== DOCKER IMAGES ====="

                    docker images ${IMAGE_NAME}
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-key',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "===== LOGIN TO NEXUS DOCKER REGISTRY ====="

                        echo "${NEXUS_PASSWORD}" | docker login localhost:8082 \
                            --username "${NEXUS_USER}" \
                            --password-stdin

                        echo "===== TAG IMAGE ====="

                        docker tag \
                            ${IMAGE_NAME}:${BUILD_NUMBER} \
                            localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}

                        echo "===== PUSH IMAGE ====="

                        docker push \
                            localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}

                        echo "===== IMAGE PUSHED ====="

                        echo "localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}"
                    '''
                }
            }
        }

        stage('Update GitOps Deployment') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-gitops',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "===== UPDATE GITOPS DEPLOYMENT ====="

                        GITOPS_DIR="gitops-repo"

                        rm -rf "${GITOPS_DIR}"

                        echo "Cloning GitOps repository..."

                        git clone \
                            https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/HaikGr/distributed-web-app-deployment.git \
                            "${GITOPS_DIR}"

                        cd "${GITOPS_DIR}"

                        echo "Selected application: ${APP}"
                        echo "Image: ${IMAGE_NAME}"
                        echo "Tag: ${BUILD_NUMBER}"

                        if [ "${APP}" = "first-app" ]; then

                            echo "Updating first-app image tag..."

                            sed -i.bak '' \
                                "s/^  tag: .*/  tag: \\${BUILD_NUMBER}\\"/" \
                                app/deployment/values-app1.yaml

                        elif [ "${APP}" = "second-app" ]; then

                            echo "Updating second-app image tag..."

                            sed -i.bak '' \
                                "s/^ tag:  .*/. tag:  \\${BUILD_NUMBER}\\"/" \
                                app/deployment/values-app2.yaml

                        else
                            echo "Unknown application: ${APP}"
                            exit 1
                        fi

                        echo "===== CHANGED FILES ====="
                        git status

                        echo "===== DIFF ====="
                        git diff

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add app/deployment/

                        git commit -m "Update ${APP} image to ${BUILD_NUMBER}"

                        git push origin main

                        echo "===== GITOPS UPDATED ====="
                    '''
                }
            }
        }
    }



    post {
        success {
            echo "Application ${params.APP} built and pushed successfully."
            echo "Image: localhost:8082/${IMAGE_NAME}:${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline failed for application: ${params.APP}"
        }
    }
}